        {
          "$ref": "component/badge.tokens.json"
        },
        {
          "$ref": "component/button.tokens.json"
        },
        {
          "$ref": "component/card.tokens.json"
        },
        {
          "$ref": "component/progress.tokens.json"
        },
        {
          "$ref": "component/segmented-control.tokens.json"
        },
        {
          "$ref": "component/text-field.tokens.json"
