{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "modifiers": {
    "appearance": {
      "contexts": {
        "contained": [],
        "pill": [
          {
            "$ref": "appearance/pill/segmented-control.tokens.json"
          }
        ]
      },
      "default": "contained",
      "description": "Coexisting appearance recipe (§9 activation)"
    },
    "theme": {
      "contexts": {
        "dark": [
          {
            "$ref": "theme/dark/color.tokens.json"
          },
          {
            "$ref": "theme/dark/elevation.tokens.json"
          }
        ],
        "dark-high-contrast": [
          {
            "$ref": "theme/dark-high-contrast/color.tokens.json"
          },
          {
            "$ref": "theme/dark-high-contrast/elevation.tokens.json"
          }
        ],
        "light": [
          {
            "$ref": "theme/light/color.tokens.json"
          },
          {
            "$ref": "theme/light/elevation.tokens.json"
          }
        ],
        "light-high-contrast": [
          {
            "$ref": "theme/light-high-contrast/color.tokens.json"
          },
          {
            "$ref": "theme/light-high-contrast/elevation.tokens.json"
          }
        ]
      },
      "default": "light",
      "description": "Color theme"
    }
  },
  "name": "Design Tokens",
  "resolutionOrder": [
    {
      "$ref": "#/sets/primitive"
    },
    {
      "$ref": "#/sets/semantic"
