                  "shadow": {
                    "inner": {
                      "$type": "shadow",
                      "$value": "{elevation.none.shadow}"
                    },
                    "outer": {
                      "$type": "shadow",
                      "$value": "{elevation.none.shadow}"
                    }
                  }
                },
                "icon": {
                  "color": {
                    "$type": "color",
                    "$value": "{color.text.disabled}"
                  }
                },
                "label": {
                  "color": {
                    "$type": "color",
                    "$value": "{color.text.disabled}"
                  }
                }
              }
            },
            "pressed": {
              "parts": {
                "container": {
                  "background": {
                    "$type": "color",
                    "$value": "{color.interactive.danger.pressed}"
                  },
                  "borderColor": {
                    "$type": "color",
                    "$value": "{color.interactive.danger.pressed}"
                  },
                  "shadow": {
