                      "$value": "{elevation.none.shadow}"
                    },
                    "outer": {
                      "$type": "shadow",
                      "$value": "{elevation.none.shadow}"
                    }
                  }
                },
                "icon": {
                  "color": {
                    "$type": "color",
                    "$value": "{color.interactive.onBold}"
                  }
                },
                "label": {
                  "color": {
                    "$type": "color",
                    "$value": "{color.interactive.onBold}"
                  }
                }
              }
            }
          }
