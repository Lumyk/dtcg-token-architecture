                  "color": {
                    "$type": "color",
                    "$value": "{color.interactive.onDanger}"
                  }
                },
                "label": {
                  "color": {
                    "$type": "color",
                    "$value": "{color.interactive.onDanger}"
                  }
                }
              }
            }
