                "$type": "dimension",
                "$value": "{primitive.spacing.16}"
              },
              "paddingVertical": {
                "$type": "dimension",
                "$value": "{primitive.spacing.8}"
              }
            },
            "icon": {
              "size": {
                "$type": "dimension",
                "$value": "{sizing.icon.medium}"
              }
            },
            "label": {
              "typography": {
                "$type": "typography",
                "$value": "{typography.label.medium}"
              }
            }
          }
        },
        "small": {
          "parts": {
            "container": {
              "cornerRadius": {
                "$type": "dimension",
                "$value": "{cornerRadius.small}"
              },
              "gap": {
                "$type": "dimension",
                "$value": "{primitive.spacing.4}"
