{
  "component": {
    "button": {
      "$description": "Use for actions. Pair each active variant's label and icon with its state's container background. Transparent containers reveal color.canvas or color.surface (excluding color.surface.inverse).",
      "$extensions": {
        "com.designsystem": {
          "schemaVersion": 1
        }
      },
      "size": {
        "large": {
          "parts": {
            "container": {
              "cornerRadius": {
                "$type": "dimension",
                "$value": "{cornerRadius.large}"
              },
              "gap": {
                "$type": "dimension",
                "$value": "{primitive.spacing.8}"
              },
              "minHeight": {
                "$type": "dimension",
                "$value": "{sizing.control.height.large}"
              },
              "paddingHorizontal": {
                "$type": "dimension",
                "$value": "{primitive.spacing.20}"
              },
              "paddingVertical": {
                "$type": "dimension",
                "$value": "{primitive.spacing.12}"
              }
            },
            "icon": {
              "size": {
                "$type": "dimension",
                "$value": "{sizing.icon.large}"
              }
            },
            "label": {
              "typography": {
                "$type": "typography",
                "$value": "{typography.label.large}"
              }
            }
          }
        },
        "medium": {
          "parts": {
            "container": {
