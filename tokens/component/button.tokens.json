      "variant": {
        "$description": "Action prominence rungs plus the destructive intent; pick by the action's rank on the screen, never by the desired look.",
        "destructive": {
          "$description": "Dangerous, irreversible actions: delete, remove, sign out. May take the primary slot in confirmation dialogs.",
          "$extensions": {
            "com.designsystem": {
              "materials": {
                "parts.container": {
                  "kind": "glass"
                }
              }
            }
          },
          "parts": {
            "container": {
              "borderWidth": {
                "$type": "dimension",
                "$value": "{primitive.borderWidth.0}"
              }
            }
          },
          "state": {
            "default": {
              "parts": {
                "container": {
                  "background": {
                    "$type": "color",
                    "$value": "{color.interactive.danger.default}"
                  },
                  "borderColor": {
                    "$type": "color",
                    "$value": "{color.interactive.danger.default}"
                  },
                  "shadow": {
                    "inner": {
                      "$type": "shadow",
                      "$value": "{elevation.none.shadow}"
                    },
                    "outer": {
                      "$type": "shadow",
                      "$value": "{elevation.none.shadow}"
                    }
                  }
                },
                "icon": {
                  "color": {
                    "$type": "color",
                    "$value": "{color.interactive.onDanger}"
                  }
                },
                "label": {
                  "color": {
                    "$type": "color",
                    "$value": "{color.interactive.onDanger}"
                  }
                }
              }
            },
            "disabled": {
              "parts": {
                "container": {
                  "background": {
                    "$type": "color",
                    "$value": "{color.interactive.danger.disabled}"
                  },
                  "borderColor": {
                    "$type": "color",
                    "$value": "{color.interactive.danger.disabled}"
